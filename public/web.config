<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sem este arquivo, o IIS aplica o cache padrão dele (Cache-Control:
  max-age=31536000, ou seja, 1 ano) a TODO arquivo estático — inclusive
  sw.js e manifest.json. Isso quebra o botão "Checar atualizações": o
  navegador serve a cópia de sw.js já em cache em vez de buscar uma nova na
  rede, então o app nunca percebe que existe uma versão mais nova publicada.

  Este arquivo sobrescreve o cache só para sw.js e manifest.json — os
  arquivos com hash no nome (_next/static/...) continuam com cache longo,
  que é o comportamento correto pra eles.
-->
<configuration>
  <location path="sw.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="manifest.json">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, must-revalidate" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
